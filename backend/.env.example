# Application
APP_NAME=Market Intelligence Platform
APP_ENV=development
DEBUG=True
API_VERSION=v1
SECRET_KEY=your-super-secret-key-change-in-production
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector Database - Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=market-intelligence

# Vector Database - Weaviate (alternative)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_API_SERVICE_NAME=youtube
YOUTUBE_API_VERSION=v3

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=MarketIntelligence/0.1.0

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_YOUTUBE=True
ENABLE_REDDIT=True
ENABLE_CACHING=True

# Limits (MVP)
MAX_VIDEOS_PER_PROJECT=100
MAX_REDDIT_POSTS_PER_PROJECT=500
MAX_PROJECTS_FREE_TIER=1
MAX_PROJECTS_PRO_TIER=10
MAX_PROJECTS_AGENCY_TIER=50
